PORT=5000
NODE_ENV=development
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=token_management
DB_USER=postgres
DB_PASSWORD=root

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_MAKER_EMAIL=maker@example.com
DEFAULT_MAKER_PASSWORD=Maker@123
DEFAULT_CHECKER_EMAIL=checker@example.com
DEFAULT_CHECKER_PASSWORD=Checker@123
DEFAULT_EXECUTOR_EMAIL=executor@example.com
DEFAULT_EXECUTOR_PASSWORD=Executor@123

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
# Reuse the same deploy keypair if you want the same program ID across localnet and devnet.
SOLANA_PROGRAM_ID=49fwAJRLMtbCLLqZDZTBKZtwDaBTgm1oA1FWnidYDQJp
SOLANA_PROGRAM_IDL_PATH=dk-token/target/idl/dk_token.json
# Replace after the first successful devnet bootstrap if you want to pin the config account explicitly.
SOLANA_CONFIG_ADDRESS=
SOLANA_CONFIG_KEYPAIR_PATH=C:\Users\itand\.config\solana\dk-config-devnet.json

# admin configured with the same keypair for localnet and devnet for convenience. Replace with a different keypair if you want to use a different admin on devnet.
SOLANA_ADMIN_KEYPAIR_PATH=C:\Users\itand\.config\solana\admin-devnet.json

# Phantom wallet pointer
SOLANA_ADMIN_KEYPAIR_PATH=C:\Users\itand\.config\solana\admin-devnet.json

# Leave blank if the maker uses Phantom/browser-wallet initiation on devnet.
SOLANA_MAKER_KEYPAIR_PATH=
SOLANA_CHECKER_KEYPAIR_PATH=C:\Users\itand\.config\solana\checker-devnet.json
SOLANA_AUTO_BOOTSTRAP=true
SOLANA_BOOTSTRAP_MODE=strict
