{
  "name": "solana-admin-portal-backend",
  "version": "1.0.0",
  "description": "Production-oriented off-chain backend foundation for a Solana testnet token admin portal",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "format": "prettier --write '**/*.{js,json,md}'",
    "bips:reconcile": "node scripts/reconcile-bips.js",
    "payments:reconcile": "node scripts/reconcile-payments.js",
    "test:backend": "node tests/run-backend-tests.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push --skip-generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "express",
    "prisma",
    "postgresql",
    "solana",
    "maker-checker"
  ],
  "license": "MIT",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-web3js-adapters": "^1.5.1",
    "@prisma/client": "^6.7.0",
    "@solana/spl-token": "^0.4.13",
    "axios": "^1.16.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.8.3",
    "prisma": "^6.7.0"
  }
}
