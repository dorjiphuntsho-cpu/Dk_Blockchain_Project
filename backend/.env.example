PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solana_admin_portal
# Alternative split DB config if you prefer not to set DATABASE_URL directly:
# DB_DIALECT=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=solana_admin_portal
# DB_USER=postgres
# DB_PASSWORD=postgres
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
AUTO_GENERATE_PRISMA=true
AUTO_SYNC_DB=true
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_MAKER_EMAIL=maker@example.com
DEFAULT_MAKER_PASSWORD=Maker@123
DEFAULT_CHECKER_EMAIL=checker@example.com
DEFAULT_CHECKER_PASSWORD=Checker@123
DEFAULT_EXECUTOR_EMAIL=executor@example.com
DEFAULT_EXECUTOR_PASSWORD=Executor@123
