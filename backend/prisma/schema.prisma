generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  MAKER
  CHECKER
  EXECUTOR
}

enum TokenRequestType {
  MINT
  TRANSFER
  BURN
}

enum TokenRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  READY_FOR_EXECUTION
  ON_CHAIN_PENDING
  EXECUTED
  FAILED
}

enum ExecutionMode {
  SERVER_MANAGED
  BROWSER_WALLET
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum SettlementRequestType {
  RESERVE_MINT
  REPLENISHMENT_MINT
  INTERBANK_TRANSFER
  REDEMPTION
}

enum SettlementMode {
  ON_CHAIN_BTN
  BIPS_FIAT
}

enum SettlementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  INQUIRY_PENDING
  INQUIRY_FAILED
  READY_FOR_EXECUTION
  BIPS_PENDING
  SETTLED
  FAILED
  MANUAL_REVIEW
  CANCELLED
}

enum ReserveStatus {
  PENDING
  APPROVED
  LOCKED
  CONSUMED
  RELEASED
  REJECTED
}

enum BankAccountType {
  RESERVE
  BIPS_SETTLEMENT
  OTHER
}

enum BankTokenAccountPurpose {
  TREASURY
  DISTRIBUTION
}

model User {
  id                   String         @id @default(uuid()) @db.Uuid
  fullName             String
  email                String         @unique
  passwordHash         String
  cid                  String?        @unique
  customerType         String?
  linkedBankAccountNumber String?
  mpinHash             String?
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  roles                UserRole[]
  wallets              Wallet[]
  madeTokenRequests    TokenRequest[] @relation("MakerTokenRequests")
  checkedTokenRequests TokenRequest[] @relation("CheckerTokenRequests")
  approvals            RequestApproval[]
  auditLogs            AuditLog[]     @relation("AuditActorLogs")
  createdManagedTokens ManagedToken[] @relation("ManagedTokenCreator")

  @@map("users")
}

model Bank {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  code               String             @unique
  binNumber          String?
  panNumber          String?
  treasuryWalletAddress String?
  supportsBtn        Boolean            @default(false)
  supportsBipsSettlement Boolean        @default(true)
  isIssuer           Boolean            @default(false)
  isActive           Boolean            @default(true)
  accounts           BankAccount[]
  tokenAccounts      BankTokenAccount[]
  reserveLedgers     ReserveLedger[]
  sourceSettlements  SettlementRequest[] @relation("SourceBankSettlements")
  destinationSettlements SettlementRequest[] @relation("DestinationBankSettlements")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([isIssuer])
  @@index([supportsBtn])
  @@index([isActive])
  @@index([treasuryWalletAddress])
  @@map("banks")
}

model BankAccount {
  id            String          @id @default(uuid()) @db.Uuid
  bankId         String          @db.Uuid
  accountType    BankAccountType
  accountName    String
  accountNumber  String
  currency       String          @default("BTN")
  isPrimary      Boolean         @default(false)
  isActive       Boolean         @default(true)
  remarks        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bank           Bank            @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([bankId, accountType, accountNumber])
  @@index([bankId, accountType])
  @@map("bank_accounts")
}

model BankTokenAccount {
  id                   String    @id @default(uuid()) @db.Uuid
  bankId               String    @db.Uuid
  mintAddress          String
  purpose              BankTokenAccountPurpose @default(TREASURY)
  treasuryWalletAddress String
  tokenAccountAddress  String    @unique
  isPrimary            Boolean   @default(true)
  isActive             Boolean   @default(true)
  remarks              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  bank                 Bank      @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([bankId, mintAddress, purpose])
  @@index([bankId])
  @@index([mintAddress])
  @@index([purpose])
  @@index([treasuryWalletAddress])
  @@map("bank_token_accounts")
}

model ReserveLedger {
  id                  String         @id @default(uuid()) @db.Uuid
  bankId              String         @db.Uuid
  referenceType       String
  referenceId         String
  currency            String         @default("BTN")
  amount              Decimal        @db.Decimal(30, 10)
  availableAmount     Decimal        @db.Decimal(30, 10)
  lockedAmount        Decimal        @default(0) @db.Decimal(30, 10)
  consumedAmount      Decimal        @default(0) @db.Decimal(30, 10)
  status              ReserveStatus  @default(PENDING)
  remarks             String?
  approvedByUserId    String?        @db.Uuid
  approvedAt          DateTime?
  consumedAt          DateTime?
  releasedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  bank                Bank           @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([bankId, referenceType, referenceId])
  @@index([bankId])
  @@index([status])
  @@index([approvedByUserId])
  @@map("reserve_ledgers")
}

model SettlementRequest {
  id                         String                @id @default(uuid()) @db.Uuid
  requestType                SettlementRequestType
  settlementMode             SettlementMode?
  status                     SettlementStatus      @default(DRAFT)
  sourceBankId               String?               @db.Uuid
  destinationBankId          String?               @db.Uuid
  reserveLedgerId            String?               @db.Uuid
  tokenMintAddress           String?
  amount                     Decimal               @db.Decimal(30, 10)
  requestId                  String?
  beneficiaryAccountName     String?
  beneficiaryAccountNumber   String?
  beneficiaryBankCode        String?
  sourceAccountName          String?
  sourceAccountNumber        String?
  transferPurpose            String?
  makerWalletAddress         String?
  sourceTokenAccountAddress  String?
  destinationTokenAccountAddress String?
  onChainRequestAddress      String?
  initiationTxSignature      String?
  initiationExplorerUrl      String?
  makerInitiatedAt           DateTime?
  referenceNumber            String?
  bipsTransactionId          String?
  inquiryResponseCode        String?
  inquiryResponseMessage     String?
  txSignature                String?
  explorerUrl                String?
  executionError             String?
  manualReviewReason         String?
  approvedAt                 DateTime?
  executedAt                 DateTime?
  settledAt                  DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  sourceBank                 Bank?                 @relation("SourceBankSettlements", fields: [sourceBankId], references: [id], onDelete: Restrict)
  destinationBank            Bank?                 @relation("DestinationBankSettlements", fields: [destinationBankId], references: [id], onDelete: Restrict)

  @@unique([requestType, requestId])
  @@index([status])
  @@index([settlementMode])
  @@index([sourceBankId])
  @@index([destinationBankId])
  @@index([reserveLedgerId])
  @@index([requestId])
  @@index([referenceNumber])
  @@index([bipsTransactionId])
  @@index([createdAt])
  @@map("settlement_requests")
}

model BipsTransactionLog {
  id                String   @id @default(uuid()) @db.Uuid
  settlementRequestId String? @db.Uuid
  requestType       String
  requestId         String?
  referenceNumber   String?
  transactionId     String?
  rawRequest        Json?
  parsedRequest     Json?
  rawResponse       Json?
  parsedResponse    Json?
  responseStatus    String?
  responseMessage   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([settlementRequestId])
  @@index([requestType])
  @@index([requestId])
  @@index([referenceNumber])
  @@index([transactionId])
  @@index([createdAt])
  @@map("bips_transaction_logs")
}

model PaymentTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  gatewayName       String
  paymentReference  String   @unique
  gatewayTransactionId String?
  customerReference String?
  payerName         String?
  payerAccount      String?
  amount            Decimal  @db.Decimal(30, 10)
  currency          String   @default("BTN")
  status            String
  statusMessage     String?
  rawCallbackPayload Json?
  rawCallbackHeaders Json?
  parsedPayload     Json?
  rawStatusResponse Json?
  parsedStatus      Json?
  lastVerifiedAt    DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([gatewayName])
  @@index([status])
  @@index([customerReference])
  @@index([gatewayTransactionId])
  @@index([confirmedAt])
  @@index([createdAt])
  @@map("payment_transactions")
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  name      RoleName  @unique
  createdAt DateTime  @default(now())
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Wallet {
  id                         String         @id @default(uuid()) @db.Uuid
  userId                     String         @db.Uuid
  walletAddress              String         @unique
  label                      String?
  isPrimary                  Boolean        @default(false)
  isActive                   Boolean        @default(true)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  user                       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTokenRequests        TokenRequest[] @relation("SourceWalletTokenRequests")
  destinationTokenRequests   TokenRequest[] @relation("DestinationWalletTokenRequests")

  @@index([userId])
  @@map("wallets")
}

model TokenRequest {
  id                           String             @id @default(uuid()) @db.Uuid
  requestType                  TokenRequestType
  tokenMintAddress             String
  amount                       Decimal            @db.Decimal(30, 10)
  sourceWalletId               String?            @db.Uuid
  destinationWalletId          String?            @db.Uuid
  makerUserId                  String             @db.Uuid
  checkerUserId                String?            @db.Uuid
  status                       TokenRequestStatus @default(DRAFT)
  executionMode                ExecutionMode      @default(SERVER_MANAGED)
  makerWalletAddress           String?
  sourceTokenAccountAddress    String?
  destinationTokenAccountAddress String?
  onChainRequestAddress        String?
  initiationTxSignature        String?
  initiationExplorerUrl        String?
  makerInitiatedAt             DateTime?
  remarks                      String?
  rejectionReason              String?
  txSignature                  String?
  explorerUrl                  String?
  executionError               String?
  approvedAt                   DateTime?
  rejectedAt                   DateTime?
  executedAt                   DateTime?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  sourceWallet                 Wallet?            @relation("SourceWalletTokenRequests", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  destinationWallet            Wallet?            @relation("DestinationWalletTokenRequests", fields: [destinationWalletId], references: [id], onDelete: Restrict)
  makerUser                    User               @relation("MakerTokenRequests", fields: [makerUserId], references: [id], onDelete: Restrict)
  checkerUser                  User?              @relation("CheckerTokenRequests", fields: [checkerUserId], references: [id], onDelete: Restrict)
  approvals                    RequestApproval[]

  @@index([status])
  @@index([requestType])
  @@index([executionMode])
  @@index([makerUserId])
  @@index([checkerUserId])
  @@index([makerWalletAddress])
  @@index([onChainRequestAddress])
  @@index([createdAt])
  @@map("token_requests")
}

model RequestApproval {
  id             String         @id @default(uuid()) @db.Uuid
  tokenRequestId String         @db.Uuid
  checkerUserId  String         @db.Uuid
  action         ApprovalAction
  comment        String?
  createdAt      DateTime       @default(now())
  tokenRequest   TokenRequest   @relation(fields: [tokenRequestId], references: [id], onDelete: Cascade)
  checkerUser    User           @relation(fields: [checkerUserId], references: [id], onDelete: Restrict)

  @@index([tokenRequestId])
  @@index([checkerUserId])
  @@map("request_approvals")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorUserId String?   @db.Uuid
  entityType  String
  entityId    String
  action      String
  metadata    Json
  createdAt   DateTime  @default(now())
  actorUser   User?     @relation("AuditActorLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ManagedToken {
  id                String   @id @default(uuid()) @db.Uuid
  name              String?
  symbol            String?
  metadataUri       String?
  metadataAddress   String?
  metadataUpdateAuthority String?
  metadataTxSignature String?
  mintAddress       String   @unique
  decimals          Int
  mintAuthority     String?
  freezeAuthority   String?
  tokenAuthority    String
  createdTxSignature String?
  explorerUrl       String?
  creatorUserId     String?  @db.Uuid
  // Phase A: Track which admin wallet created this token
  adminWalletAddress String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  creatorUser       User?    @relation("ManagedTokenCreator", fields: [creatorUserId], references: [id], onDelete: SetNull)

  @@index([creatorUserId])
  @@index([createdAt])
  @@map("managed_tokens")
}
